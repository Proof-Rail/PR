{
    "root":  true,
    "env":  {
                "node":  true,
                "es2020":  true
            },
    "parser":  "@typescript-eslint/parser",
    "parserOptions":  {
                          "ecmaVersion":  2020,
                          "sourceType":  "module"
                      },
    "extends":  [
                    "eslint:recommended"
                ],
    "ignorePatterns":  [
                           "dist/",
                           "node_modules/"
                       ],
    "rules":  {
                  "no-unused-vars":  "off",
                  "no-undef":  "off"
              }
}
