# ─────────────────────────────────────────────────────────────────────────────
# PROOFRAIL — Environment Configuration
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT: Only NEXT_PUBLIC_* variables belong here.
#   - Next.js inlines these into the client bundle at build time.
#   - Never put private keys, signing secrets, or server-only credentials here.
#
# The app enters "demo mode" automatically when NEXT_PUBLIC_ESCROW_CONTRACT_ID
# is empty. In demo mode all reads return empty/not-found state and writes
# simulate success locally — no wallet or testnet account is required.
# ─────────────────────────────────────────────────────────────────────────────


# ── Stellar network ───────────────────────────────────────────────────────────
# Which Stellar network to target.
# Accepted values: testnet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC endpoint.
# Testnet default:  https://soroban-testnet.stellar.org
# Mainnet default:  https://soroban-mainnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Horizon REST API endpoint (used for account lookups and transaction status).
# Testnet default:  https://horizon-testnet.stellar.org
# Mainnet default:  https://horizon.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org


# ── Contract IDs ──────────────────────────────────────────────────────────────
# Populated after you run `npm run contracts:build` and deploy with Stellar CLI.
# See docs/DEPLOYMENT.md for the full deployment runbook.
#
# Leaving NEXT_PUBLIC_ESCROW_CONTRACT_ID empty activates demo mode.
NEXT_PUBLIC_ESCROW_CONTRACT_ID=

# Optional future registry contract (not required for core escrow functionality).
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=


# ── Demo / development flags ──────────────────────────────────────────────────
# Set to "true" to force demo mode even when a contract ID is configured.
# Useful for UI development without a live testnet deployment.
NEXT_PUBLIC_DEMO_MODE=false


# ── Wallet configuration ──────────────────────────────────────────────────────
# Network hint passed to the wallet kit on initialisation.
# Should match NEXT_PUBLIC_STELLAR_NETWORK: TESTNET | PUBLIC
NEXT_PUBLIC_WALLET_NETWORK=TESTNET


# ── Application URL ───────────────────────────────────────────────────────────
# Canonical public URL — used for OpenGraph metadata and absolute links.
# Include protocol, no trailing slash.
# Example: https://app.proofrail.xyz
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Optional: off-chain storage adapter ──────────────────────────────────────
# PROOFRAIL is database-free by design. If you add an off-chain indexer or
# storage layer for evidence files / agreement history, set its base URL here.
# Not required for the core on-chain functionality.
# NEXT_PUBLIC_STORAGE_ADAPTER_URL=
